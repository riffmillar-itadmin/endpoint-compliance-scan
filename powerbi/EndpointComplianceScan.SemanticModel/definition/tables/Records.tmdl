/// One row per requirement per scan, read from every .records.json file in ReportFolder.
table Records
	lineageTag: fe407b41-d776-58cd-bbe4-f9b8a71a91d8

	/// F Fail, E Error, A Accepted, S Skipped, M Manual, P Pass, - N/A. Blank when more than one scan is in context.
	measure 'State code' = SWITCH(SELECTEDVALUE(Records[State]), "Fail", "F", "Error", "E", "Accepted", "A", "Skipped", "S", "Manual", "M", "Pass", "P", "NotApplicable", "-")
		lineageTag: 4e3cf842-bef9-58dd-9ec4-bfe4092e2dd4

	/// Scans in context where the requirement is Fail or Error.
	measure 'Machines failing' = CALCULATE(DISTINCTCOUNT(Records[ScanKey]), Records[State] IN {"Fail", "Error"})
		formatString: 0
		lineageTag: a6c60639-9306-5fd7-9376-8fd850e0d1d4

	column ScanKey
		dataType: string
		isHidden
		lineageTag: ce4685f6-9a94-5428-aaee-f77cc4499de1
		summarizeBy: none
