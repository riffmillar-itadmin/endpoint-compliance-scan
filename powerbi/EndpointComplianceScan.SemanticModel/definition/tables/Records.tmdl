	partition Records = m
		mode: import
		source =
				let
				    Files = Folder.Files(ReportFolder),
				    ReportFiles = Table.SelectRows(Files, each Text.EndsWith(Text.Lower([Name]), ".records.json")),
				    Checked = if Table.IsEmpty(ReportFiles)
				        then error Error.Record("No scan reports", "No .records.json files in " & ReportFolder & ". Change the ReportFolder parameter.")
				        else ReportFiles,
				    Parsed = Table.AddColumn(Checked, "Rows", each let d = Json.Document([Content]) in if d is list then d else {d}),
				    Rows = Table.ExpandListColumn(Table.SelectColumns(Parsed, {"Rows"}), "Rows"),
				    Fields = Table.ExpandRecordColumn(Rows, "Rows", {"ScanId", "ComputerName", "CollectedUtc", "OSCaption", "OSVersion", "ProductType", "PartOfDomain", "IsElevated", "ToolVersion", "Framework", "FrameworkName", "FrameworkLevel", "CatalogComplete", "PlatformWarning", "Requirement", "Reference", "RequirementLevel", "Family", "Title", "State", "Checks", "Findings", "Evidence", "Note"}),
				    Typed = Table.TransformColumnTypes(Fields, {{"ScanId", type text}, {"ComputerName", type text}, {"OSCaption", type text}, {"OSVersion", type text}, {"ProductType", Int64.Type}, {"PartOfDomain", type logical}, {"IsElevated", type logical}, {"ToolVersion", type text}, {"Framework", type text}, {"FrameworkName", type text}, {"FrameworkLevel", type text}, {"CatalogComplete", type logical}, {"PlatformWarning", type text}, {"Requirement", type text}, {"Reference", type text}, {"RequirementLevel", type text}, {"Family", type text}, {"Title", type text}, {"State", type text}, {"Checks", type text}, {"Findings", type text}, {"Evidence", type text}, {"Note", type text}}),
				    Collected = Table.TransformColumns(Typed, {{"CollectedUtc", each DateTimeZone.RemoveZone(DateTimeZone.ToUtc(DateTimeZone.From(_))), type datetime}}),
				    Keyed = Table.AddColumn(Collected, "ScanKey", each [ScanId] & "|" & [Framework], type text),
				    Labelled = Table.AddColumn(Keyed, "RequirementLabel", each Text.Combine(List.Select({[Reference], [Title]}, each _ <> null and _ <> ""), " "), type text)
				in
				    Labelled

	annotation PBI_ResultType = Table

