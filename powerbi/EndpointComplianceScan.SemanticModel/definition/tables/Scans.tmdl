/// One row per scan and framework, with a count per state. Built from Records.
table Scans
	lineageTag: 4bf0ab3e-2105-5a25-ad44-2d7eed63bf2d

	measure Machines = DISTINCTCOUNT(Scans[ComputerName])
		formatString: 0
		lineageTag: f502013d-c1e3-5a32-b8d9-c787551c4f1f

	measure 'Stale machines' = CALCULATE(DISTINCTCOUNT(Scans[ComputerName]), Scans[IsStale] = TRUE()) + 0
		formatString: 0
		lineageTag: 0c9c4da7-a85b-5f33-ad08-c60edeea7a26

	measure 'Fail count' = SUM(Scans[Fail])
		formatString: 0
		lineageTag: 7695f434-de4e-58aa-a8bf-d05d0d7b6b3a

	measure 'Error count' = SUM(Scans[Error])
		formatString: 0
		lineageTag: 63c20fec-ef65-501b-bca1-80417b626985

	measure 'Accepted count' = SUM(Scans[Accepted])
		formatString: 0
		lineageTag: a3d5af45-2c1f-5fcc-beca-5d8299a78cd1

	measure 'Skipped count' = SUM(Scans[Skipped])
		formatString: 0
		lineageTag: 11831c21-8e57-5e75-ab1d-8caae1aca886

	measure 'Manual count' = SUM(Scans[Manual])
		formatString: 0
		lineageTag: 348570fb-e935-53cd-a57a-595bba4e69f1

	measure 'Pass count' = SUM(Scans[Pass])
		formatString: 0
		lineageTag: 93d6e61b-ff04-505d-8327-bdd7bf71edf8

	measure 'N/A count' = SUM(Scans[N/A])
		formatString: 0
		lineageTag: dc5c7eba-0c91-5909-ac2d-4d49887b571f

	column ScanKey
		dataType: string
		isHidden
		lineageTag: 815558fb-8bdb-5f28-a0b8-7c87932e520e
		summarizeBy: none
		sourceColumn: ScanKey

		annotation SummarizationSetBy = User

	column ScanId
		dataType: string
		isHidden
		lineageTag: c812e8e1-bd09-5e7e-bacc-cd9dd7dd5370
		summarizeBy: none
		sourceColumn: ScanId

		annotation SummarizationSetBy = User

