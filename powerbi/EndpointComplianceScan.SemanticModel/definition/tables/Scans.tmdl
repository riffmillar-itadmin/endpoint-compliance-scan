	/// Blank for a machine's first scan, then Yes or No: same level and requirements as the scan before.
	column ComparableWithPrevious
		dataType: string
		lineageTag: 8fc173ec-ed38-5ed2-b2f7-3b1e251c5622
		summarizeBy: none
		sourceColumn: ComparableWithPrevious

		annotation SummarizationSetBy = User

	/// The machine name, with the start date of each comparable run when it has more than one, so trend lines break.
	column TrendSeries
		dataType: string
		lineageTag: 78443b9f-7f58-557a-8de1-5a100216cac0
		summarizeBy: none
		sourceColumn: TrendSeries

		annotation SummarizationSetBy = User

	/// The machine's latest scan for the framework.
	column IsLatest
		dataType: boolean
		lineageTag: 523f7ece-e6ed-5bf7-bb1f-c8d870873928
		summarizeBy: none
		sourceColumn: IsLatest

		annotation SummarizationSetBy = User

	column AgeDays
		dataType: int64
		lineageTag: 2c8922f5-a599-58a5-b1ea-5f2bcb2a0885
		summarizeBy: none
		sourceColumn: AgeDays

		annotation SummarizationSetBy = User

	column IsStale
		dataType: boolean
		lineageTag: 36d64524-30e5-514a-a265-61337602e741
		summarizeBy: none
		sourceColumn: IsStale

		annotation SummarizationSetBy = User

	column InTrendWindow
		dataType: boolean
		isHidden
		lineageTag: 2ffa21ad-623c-57c8-96a0-22030b315e89
		summarizeBy: none
		sourceColumn: InTrendWindow

		annotation SummarizationSetBy = User

	column Flags
		dataType: string
		lineageTag: 76746bb3-7db1-59a2-b8dc-48a279858d72
		summarizeBy: none
		sourceColumn: Flags

		annotation SummarizationSetBy = User

	partition Scans = m
		mode: import
		source =
				let
				    Now = DateTimeZone.RemoveZone(DateTimeZone.UtcNow()),
				    Grouped = Table.Group(Records,
				        {"ScanKey", "ScanId", "ComputerName", "CollectedUtc", "OSCaption", "OSVersion", "Framework", "FrameworkName", "FrameworkLevel", "ToolVersion", "IsElevated", "PlatformWarning", "CatalogComplete"},
				        {
				            {"Requirements", each Table.RowCount(_), Int64.Type},
				            {"Fail", each List.Count(List.Select([State], (x) => x = "Fail")), Int64.Type},
				            {"Error", each List.Count(List.Select([State], (x) => x = "Error")), Int64.Type},
				            {"Accepted", each List.Count(List.Select([State], (x) => x = "Accepted")), Int64.Type},
				            {"Skipped", each List.Count(List.Select([State], (x) => x = "Skipped")), Int64.Type},
				            {"Manual", each List.Count(List.Select([State], (x) => x = "Manual")), Int64.Type},
				            {"Pass", each List.Count(List.Select([State], (x) => x = "Pass")), Int64.Type},
				            {"NotApplicable", each List.Count(List.Select([State], (x) => x = "NotApplicable")), Int64.Type},
				            {"RequirementSet", each Text.Combine(List.Sort(List.Transform([Requirement], Text.From)), ";"), type text}
				        }),
				    // Within each machine and framework, oldest first: is this scan comparable
				    // with the one before it (same level, same requirements), and which run of
				    // comparable scans does it belong to. Counts don't compare across a break.
				    Annotate = (t as table) as list =>
				        let
				            Rows = Table.ToRecords(Table.Sort(t, {{"CollectedUtc", Order.Ascending}})),
				            Last = List.Count(Rows) - 1,
				            Walk = List.Accumulate(List.Positions(Rows), [Out = {}, Segment = 0, Start = null],
				                (s, i) =>
				                    let
				                        r = Rows{i},
				                        p = if i = 0 then null else Rows{i - 1},
				                        same = p <> null and r[FrameworkLevel] = p[FrameworkLevel] and r[RequirementSet] = p[RequirementSet],
				                        seg = if same then s[Segment] else s[Segment] + 1,
				                        start = if same then s[Start] else r[CollectedUtc]
				                    in
				                        [Out = s[Out] & {r & [
				                            ComparableWithPrevious = if p = null then "" else if same then "Yes" else "No",
				                            Segment = seg, SegmentStart = start, IsLatest = (i = Last)]},
				                         Segment = seg, Start = start])
				        in
				            List.Transform(Walk[Out], each _ & [Segments = Walk[Segment]]),
				    ByMachine = Table.Group(Grouped, {"ComputerName", "Framework"}, {{"Rows", Annotate}}),
				    Annotated = Table.FromRecords(List.Combine(ByMachine[Rows])),
				    Series = Table.AddColumn(Annotated, "TrendSeries", each
				        if [Segments] = 1 then [ComputerName]
				        else [ComputerName] & " from " & Date.ToText(Date.From([SegmentStart]), "yyyy-MM-dd"), type text),
				    Age = Table.AddColumn(Series, "AgeDays", each Duration.Days(Now - [CollectedUtc]), Int64.Type),
				    Stale = Table.AddColumn(Age, "IsStale", each [AgeDays] > StaleDays, type logical),
				    Window = Table.AddColumn(Stale, "InTrendWindow", each [IsLatest] or [CollectedUtc] >= Now - #duration(TrendDays, 0, 0, 0), type logical),
				    Flags = Table.AddColumn(Window, "Flags", each Text.Combine(List.RemoveNulls({
				        if [IsStale] then "Stale" else null,
				        if [IsElevated] = false then "Not elevated" else null,
				        if [PlatformWarning] <> null and [PlatformWarning] <> "" then "Platform warning" else null}), ", "), type text),
				    Renamed = Table.RenameColumns(Flags, {{"FrameworkLevel", "Level"}, {"NotApplicable", "N/A"}}),
				    Kept = Table.RemoveColumns(Renamed, {"Segments", "SegmentStart"}),
				    Typed = Table.TransformColumnTypes(Kept, {
				        {"ScanKey", type text}, {"ScanId", type text}, {"ComputerName", type text}, {"CollectedUtc", type datetime},
				        {"OSCaption", type text}, {"OSVersion", type text}, {"Framework", type text}, {"FrameworkName", type text},
				        {"Level", type text}, {"ToolVersion", type text}, {"IsElevated", type logical}, {"PlatformWarning", type text},
				        {"CatalogComplete", type logical}, {"Requirements", Int64.Type}, {"Fail", Int64.Type}, {"Error", Int64.Type},
				        {"Accepted", Int64.Type}, {"Skipped", Int64.Type}, {"Manual", Int64.Type}, {"Pass", Int64.Type}, {"N/A", Int64.Type},
				        {"RequirementSet", type text}, {"ComparableWithPrevious", type text}, {"Segment", Int64.Type},
				        {"IsLatest", type logical}})
				in
				    Typed

	annotation PBI_ResultType = Table

