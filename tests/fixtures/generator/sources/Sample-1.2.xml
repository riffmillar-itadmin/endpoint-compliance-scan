      <OrganizationValueRequired>True</OrganizationValueRequired>
      <RawString>Check MaxIdleTime is under 15 minutes.</RawString>
      <ValueData />
      <ValueName>MaxIdleTime</ValueName>
      <ValueType>Dword</ValueType>
    </Rule>
    <Rule id="V-900006" severity="medium" title="SRG-OS-000006">
      <Description>&lt;VulnDiscussion&gt;A rule DISA later retired.&lt;/VulnDiscussion&gt;</Description>
      <Key>HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Westmark</Key>
      <OrganizationValueRequired>False</OrganizationValueRequired>
      <RawString>Check Retired.</RawString>
      <ValueData>1;2</ValueData>
      <ValueName>Retired</ValueName>
      <ValueType>MultiString</ValueType>
    </Rule>
    <Rule id="V-900016" severity="low" title="SRG-OS-000016">
