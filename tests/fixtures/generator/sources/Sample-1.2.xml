  <RegistryRule dscresourcemodule="PSDscResources">
    <Rule id="V-900001" severity="medium" title="SRG-OS-000001">
      <Description>&lt;VulnDiscussion&gt;UAC limits what software can do.&lt;/VulnDiscussion&gt;</Description>
      <Key>HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System</Key>
      <OrganizationValueRequired>False</OrganizationValueRequired>
      <RawString>Check EnableLUA is 1.</RawString>
      <ValueData>1</ValueData>
      <ValueName>EnableLUA</ValueName>
      <ValueType>Dword</ValueType>
    </Rule>
    <Rule id="V-900002.a" severity="medium" title="SRG-OS-000002">
      <Description>&lt;VulnDiscussion&gt;Two parts &amp;amp; one rule.&lt;/VulnDiscussion&gt;</Description>
      <Key>HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System</Key>
      <OrganizationValueRequired>False</OrganizationValueRequired>
      <RawString>Check both.</RawString>
      <ValueData>0x00000001</ValueData>
      <ValueName>PromptOnSecureDesktop</ValueName>
      <ValueType>Dword</ValueType>
    </Rule>
    <Rule id="V-900002.b" severity="medium" title="SRG-OS-000002">
      <Description>&lt;VulnDiscussion&gt;Two parts &amp;amp; one rule.&lt;/VulnDiscussion&gt;</Description>
