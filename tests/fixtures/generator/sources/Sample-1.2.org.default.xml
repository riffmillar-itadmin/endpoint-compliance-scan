<!-- Organization-defined values for Sample-1.2.xml, in PowerStig's layout. -->
<OrganizationalSettings fullversion="1.2">
  <!-- Ensure ''V-900003'' -le '900000' -and ''V-900003'' -ne '0'-->
  <OrganizationalSetting id="V-900003" ValueData="900000" />
  <!-- Ensure ''V-900007'' -le '3' -and ''V-900007'' -ne '0'-->
  <OrganizationalSetting id="V-900007" PolicyValue="3" />
  <!-- Ensure ''V-900010'' -match '^(Administrators|Administrators,Local account)$'-->
  <OrganizationalSetting id="V-900010" Identity="Administrators" />
  <!-- Ensure ''V-900015'' -match 'Administrators,(Backup Operators|Local account)'-->
  <OrganizationalSetting id="V-900015" Identity="Administrators" />
</OrganizationalSettings>
